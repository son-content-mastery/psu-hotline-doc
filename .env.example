# PostgreSQL (local development only)
POSTGRES_DB=hotline_doc
POSTGRES_USER=hotline_doc
POSTGRES_PASSWORD=local-demo-only-change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Django (unsafe local/demo defaults; replace secrets in your uncommitted .env)
DJANGO_SECRET_KEY=unsafe-local-development-secret-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
MEDIA_ROOT=/app/media
MAX_UPLOAD_SIZE_MB=10
DEMO_PASSWORD=DemoPass123!
RUN_DEMO_SEED=true
# Only the backend web service owns migrations; workers keep this false.
RUN_MIGRATIONS=true
PASSWORD_RESET_THROTTLE_RATE=5/hour
REGISTRATION_THROTTLE_RATE=5/hour
ACTIVATION_THROTTLE_RATE=5/hour
ACCOUNT_EMAIL_THROTTLE_RATE=5/hour

# Email delivery is console-only by default. For Gmail SMTP, replace the two
# credential placeholders and switch EMAIL_BACKEND to the smtp backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=replace-with-your-gmail-address
EMAIL_HOST_PASSWORD=replace-with-google-app-password
EMAIL_TIMEOUT_SECONDS=10
# SMTP safety: never attempt delivery to RFC-reserved demo domains.
EMAIL_SUPPRESSED_DOMAINS=example.test,example.com,example.org
ACCOUNT_ACTIVATION_TOKEN_MAX_AGE_SECONDS=86400
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OUTBOX_RETRY_BASE_SECONDS=60
EMAIL_OUTBOX_POLL_SECONDS=30
WORKFLOW_NOTIFICATION_EMAIL_ENABLED=true
# Renewal reminders reuse the email outbox. Keep days positive and comma-separated.
LICENSE_RENEWAL_REMINDERS_ENABLED=true
LICENSE_RENEWAL_REMINDER_DAYS=90,30,7
LICENSE_RENEWAL_SCAN_SECONDS=3600
EXPECTED_LOCAL_AUTHORITY_COUNT=19
DEFAULT_FROM_EMAIL=HoTLinE Doc <noreply@example.test>
FRONTEND_BASE_URL=http://localhost:5173

# Vite
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://backend:8000
